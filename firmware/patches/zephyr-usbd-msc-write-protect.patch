 	INVALID_FIELD_IN_CDB = 0x2400,
 	MEDIUM_NOT_PRESENT = 0x3A00,
 	MEDIUM_REMOVAL_PREVENTED = 0x5302,
+	WRITE_PROTECTED = 0x2700,
 	WRITE_ERROR = 0x0C00,
 };
 
